{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertificateReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_description", "data_description", "dataset_split", "checkpoint_file", "reference_semantics", "target_semantics", "static_family", "sample_count", "confidence_level", "certified_input_fraction", "semantic_disagreement_count", "semantic_bound", "conformance_disagreement_count", "conformance_bound", "total_bound", "decision_budget", "budget_verdict", "conditional_on_emulator", "code_revision", "random_seed", "firmware_version", "bitstream_file", "assumptions", "member_bounds"],
  "properties": {
    "schema_version": {"const": "CertificateReport/v1"},
    "model_description": {"type": "string"},
    "data_description": {"type": "string"},
    "dataset_split": {"type": "string"},
    "checkpoint_file": {"type": "string"},
    "reference_semantics": {"type": "string"},
    "target_semantics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "static_family": {"type": "string"},
    "sample_count": {"type": "integer", "minimum": 1},
    "confidence_level": {"type": "number", "minimum": 0, "maximum": 1},
    "certified_input_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "semantic_disagreement_count": {"type": "integer", "minimum": 0},
    "semantic_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "conformance_disagreement_count": {"type": ["integer", "null"], "minimum": 0},
    "conformance_bound": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "total_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_budget": {"type": "number", "minimum": 0, "maximum": 1},
    "budget_verdict": {"enum": ["accept", "reject"]},
    "conditional_on_emulator": {"type": "boolean"},
    "code_revision": {"type": "string"},
    "random_seed": {"type": "string"},
    "firmware_version": {"type": ["string", "null"]},
    "bitstream_file": {"type": ["string", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "member_bounds": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
