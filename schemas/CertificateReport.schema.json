{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertificateReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_hash", "data_hash", "dataset_split", "checkpoint_hash", "reference_semantics_hash", "target_semantics_hashes", "static_family_hash", "sample_count", "confidence_level", "certified_input_fraction", "semantic_disagreement_count", "semantic_bound", "conformance_disagreement_count", "conformance_bound", "total_bound", "decision_budget", "budget_verdict", "conditional_on_emulator", "code_revision", "random_seed_hash", "firmware_hash", "bitstream_hash", "assumptions", "member_bounds"],
  "properties": {
    "schema_version": {"const": "CertificateReport/v1"},
    "model_hash": {"type": "string", "minLength": 32},
    "data_hash": {"type": "string", "minLength": 32},
    "dataset_split": {"type": "string"},
    "checkpoint_hash": {"type": "string"},
    "reference_semantics_hash": {"type": "string"},
    "target_semantics_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "static_family_hash": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "confidence_level": {"type": "number", "minimum": 0, "maximum": 1},
    "certified_input_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "semantic_disagreement_count": {"type": "integer", "minimum": 0},
    "semantic_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "conformance_disagreement_count": {"type": ["integer", "null"], "minimum": 0},
    "conformance_bound": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "total_bound": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_budget": {"type": "number", "minimum": 0, "maximum": 1},
    "budget_verdict": {"enum": ["accept", "reject"]},
    "conditional_on_emulator": {"type": "boolean"},
    "code_revision": {"type": "string"},
    "random_seed_hash": {"type": "string"},
    "firmware_hash": {"type": ["string", "null"]},
    "bitstream_hash": {"type": ["string", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "member_bounds": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
