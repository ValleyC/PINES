{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pines.invalid/schema/ExecutionSemantics-v1.json",
  "title": "ExecutionSemantics/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timestep", "integration_rule", "threshold_timing", "update_ordering", "reset_rule", "state_format", "weight_format", "synaptic_delay_steps", "output_delay_steps", "randomness"],
  "properties": {
    "version": {"const": "1.0"},
    "timestep": {"type": "number", "exclusiveMinimum": 0},
    "integration_rule": {"enum": ["forward_euler", "exponential_euler"]},
    "threshold_timing": {"enum": ["pre_integration", "post_integration"]},
    "update_ordering": {"enum": ["threshold>reset>integrate", "integrate>threshold>reset"]},
    "reset_rule": {"enum": ["subtractive", "to_value"]},
    "state_format": {"$ref": "#/$defs/numeric"},
    "weight_format": {"$ref": "#/$defs/numeric"},
    "synaptic_delay_steps": {"type": "integer", "minimum": 0},
    "output_delay_steps": {"type": "integer", "minimum": 0},
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "seed"],
      "properties": {"deterministic": {"type": "boolean"}, "seed": {"type": "integer"}}
    }
  },
  "$defs": {
    "numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rounding", "overflow"],
      "properties": {
        "kind": {"enum": ["float64", "fixed"]},
        "total_bits": {"type": ["integer", "null"], "minimum": 2},
        "fractional_bits": {"type": ["integer", "null"], "minimum": 0},
        "rounding": {"enum": ["nearest_even", "floor", "truncate", "stochastic"]},
        "overflow": {"enum": ["saturate", "wrap"]}
      }
    }
  }
}
