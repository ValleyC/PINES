{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HardwareRunManifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "backend_serial", "adapter_version", "firmware_version", "bitstream_file", "semantics_description", "model_description", "dataset_name", "seed", "run_id", "timestamp_utc", "capture_file", "independent_pairing"],
  "properties": {
    "schema_version": {"const": "HardwareRunManifest/v1"},
    "backend": {"enum": ["spinnaker1", "spinnaker2", "virtex7"]},
    "backend_serial": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "firmware_version": {"type": "string", "minLength": 1},
    "bitstream_file": {"type": ["string", "null"]},
    "semantics_description": {"type": "string", "minLength": 1},
    "model_description": {"type": "string", "minLength": 1},
    "dataset_name": {"type": "string", "minLength": 1},
    "seed": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "capture_file": {"type": "string", "minLength": 1},
    "independent_pairing": {"const": true}
  }
}
