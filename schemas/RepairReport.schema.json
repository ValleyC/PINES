{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_certificate", "permitted_parameter_changes", "calibration_split", "audit_split", "data_budget", "label_budget", "optimization_evaluations", "optimization_seconds", "original_model", "repaired_model", "pre_repair_objective", "post_repair_objective", "post_repair_certificate", "selected_changes", "code_revision"],
  "properties": {
    "schema_version": {"const": "RepairReport/v1"},
    "source_certificate": {"type": "string"},
    "permitted_parameter_changes": {"type": "array", "items": {"type": "string"}},
    "calibration_split": {"type": "string"},
    "audit_split": {"type": "string"},
    "data_budget": {"type": "integer", "minimum": 1},
    "label_budget": {"type": "integer", "minimum": 0},
    "optimization_evaluations": {"type": "integer", "minimum": 1},
    "optimization_seconds": {"type": "number", "minimum": 0},
    "original_model": {"type": "string"},
    "repaired_model": {"type": "string"},
    "pre_repair_objective": {"type": "number"},
    "post_repair_objective": {"type": "number"},
    "post_repair_certificate": {"type": "string"},
    "selected_changes": {"type": "array", "items": {"type": "object"}},
    "code_revision": {"type": "string"}
  }
}
